<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#F6F8FC"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:padding="20dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="FotoGPSApp"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/ivFoto"
            android:contentDescription="Vista previa"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:background="#E3EAF5"
            android:layout_width="match_parent"
            android:layout_height="220dp" />

        <LinearLayout
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnTomarFoto"
                android:text="Tomar Foto"
                android:backgroundTint="#1E88E5"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnUbicacion"
                android:text="Obtener Ubicación"
                android:backgroundTint="#43A047"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCoordenadas"
            android:text="Lat: -, Lon: -"
            android:textSize="16sp"
            android:textColor="#263238"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvDireccion"
            android:text="Dirección: -"
            android:textSize="16sp"
            android:textColor="#455A64"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnVerMaps"
                android:text="Ver en Maps"
                android:backgroundTint="#F4511E"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnLimpiar"
                android:text="Limpiar"
                android:layout_marginStart="10dp"
                android:backgroundTint="#FB8C00"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEstado"
            android:text="Estado: listo."
            android:textStyle="italic"
            android:textColor="#616161"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>